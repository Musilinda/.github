# ---- Musilinda deploy config -------------------------------------------------
# Copy this file to deploy/secrets.env and fill in real values.
# secrets.env is gitignored and never committed. bootstrap.sh sources it.

# Base domain. nginx serves app.$DOMAIN, blog.$DOMAIN, and $DOMAIN / www.$DOMAIN.
DOMAIN=musilinda.com

# --- Postgres (on-box) --------------------------------------------------------
# Passwords for the two per-service DB roles that bootstrap creates.
MUSILINDA_DB_PASSWORD=change_me_musilinda
BLOG_DB_PASSWORD=change_me_blog

# --- Application secrets -------------------------------------------------------
SESSION_SECRET=change_me_long_random_string   # app_musilinda session signing
JWT_SECRET=change_me_long_random_string        # blog auth tokens
SENDGRID_API_KEY=                              # optional; app_musilinda email (blank OK for PoC)

# --- Source acquisition (optional) --------------------------------------------
# How bootstrap gets each service's code:
#   * If $SRC_ROOT/<service> already contains the code (you staged it), it is used as-is.
#   * Otherwise, if <SVC>_REPO is set below, bootstrap clones it at the given ref.
# Leave the *_REPO lines commented to require pre-staged source (simplest for the local VM PoC).
#
# API_REPO=git@github.com:youruser/api.git
# APP_REPO=git@github.com:youruser/app_musilinda.git
# BLOG_REPO=git@github.com:youruser/blog.git
# WEB_REPO=git@github.com:youruser/web.git
#
# Ref (branch/tag) to check out when cloning:
API_REF=claude/aws
APP_REF=claude/aws
BLOG_REF=claude/blog_storage_aws   # blog's filesystem-storage work lives on this branch
WEB_REF=claude/aws

# --- Overridable paths / ports (defaults are fine for the PoC) ----------------
# SRC_ROOT=/srv/musilinda
# RUN_USER=musilinda
# BLOB_STORAGE_DIR=/var/lib/musilinda-blog/blob-store
